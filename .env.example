# IssueBot environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored — your secrets stay local.
# Sourced automatically by run.sh on startup.

GITHUB_TOKEN=ghp_your_token_here

# Dashboard authentication (optional — leave blank to disable)
ISSUEBOT_USERNAME=admin
ISSUEBOT_PASSWORD=changeme

# GitHub webhook signature secret (optional — leave blank to disable webhooks)
ISSUEBOT_WEBHOOK_SECRET=

# Provider credentials do not belong here. codex-cli-provider is configured and
# released independently; see docs/deployment.md. Production Docker cutover is
# gated until IssueBot no longer invokes the local claude executable directly.
