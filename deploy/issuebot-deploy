#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly DEPLOY_CONFIG=/home/dbbaskette/.config/issuebot/deploy.env

reject() {
  printf 'ERROR: remote deployment command rejected\n' >&2
  return 1
}

original_command="${SSH_ORIGINAL_COMMAND:-}"
[[ -n "$original_command" ]] || reject || exit 1
[[ "$original_command" =~ ^[A-Za-z0-9._/[:space:]-]+$ ]] || reject || exit 1

normalized_command="$(printf '%s' "$original_command" | tr '[:space:]' ' ')"
read -r -a command_parts <<<"$normalized_command"
(( ${#command_parts[@]} >= 1 && ${#command_parts[@]} <= 3 )) || reject || exit 1

case "${command_parts[0]}:${#command_parts[@]}" in
  preflight:1|deploy:1|rollback:1|status:1) ;;
  logs:3)
    case "${command_parts[1]}" in
      issuebot|codex-cli-provider) ;;
      *) reject || exit 1 ;;
    esac
    [[ "${command_parts[2]}" =~ ^[0-9]{1,3}$ ]] || reject || exit 1
    (( 10#${command_parts[2]} >= 1 && 10#${command_parts[2]} <= 500 )) || reject || exit 1
    ;;
  *) reject || exit 1 ;;
esac

[[ -f "$DEPLOY_CONFIG" && ! -L "$DEPLOY_CONFIG" ]] || {
  printf 'ERROR: deployment configuration is missing or unsafe\n' >&2
  exit 1
}
ISSUEBOT_CHECKOUT="$(awk -F= '$1 == "ISSUEBOT_CHECKOUT" { print substr($0, index($0, "=") + 1); exit }' "$DEPLOY_CONFIG")"
[[ "$ISSUEBOT_CHECKOUT" == /* && -d "$ISSUEBOT_CHECKOUT" && ! -L "$ISSUEBOT_CHECKOUT" ]] || {
  printf 'ERROR: deployment checkout is missing or unsafe\n' >&2
  exit 1
}

cd "$ISSUEBOT_CHECKOUT"
# shellcheck source=deploy/lib/common.sh
source deploy/lib/common.sh
DEPLOY_ENV="$DEPLOY_CONFIG"
export DEPLOY_ENV
load_deploy_env "$DEPLOY_ENV"
[[ "$PWD" == "$ISSUEBOT_CHECKOUT" ]] || die 'deployment checkout changed while loading configuration'
# shellcheck source=deploy/lib/preflight.sh
source deploy/lib/preflight.sh
# shellcheck source=deploy/lib/lifecycle.sh
source deploy/lib/lifecycle.sh

load_readonly_compose_context() {
  local manifest manifest_data record key value issuebot_git_sha='' deployed_at=''
  local issuebot_git_sha_count=0 deployed_at_count=0
  manifest="$ISSUEBOT_HOME/deployments/current.manifest"
  manifest_data="$(read_manifest "$manifest")" || return 1
  while IFS= read -r record; do
    key="${record%%=*}"
    value="${record#*=}"
    case "$key" in
      issuebot_git_sha)
        (( ++issuebot_git_sha_count ))
        issuebot_git_sha="$value"
        ;;
      deployed_at)
        (( ++deployed_at_count ))
        deployed_at="$value"
        ;;
    esac
  done <<<"$manifest_data"

  (( issuebot_git_sha_count == 1 )) || die 'current deployment manifest must contain exactly one issuebot_git_sha' || return 1
  [[ "$issuebot_git_sha" =~ ^[0-9a-f]{40}$ ]] || die 'current deployment manifest has invalid issuebot_git_sha' || return 1
  (( deployed_at_count == 1 )) || die 'current deployment manifest must contain exactly one deployed_at' || return 1
  [[ "$deployed_at" =~ ^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$ ]] || die 'current deployment manifest has invalid deployed_at' || return 1

  ISSUEBOT_GIT_SHA="$issuebot_git_sha"
  BUILD_DATE="$deployed_at"
  export ISSUEBOT_GIT_SHA BUILD_DATE
}

dispatch() {
  case "${command_parts[0]}" in
    preflight) preflight_all ;;
    deploy) deploy_release ;;
    rollback)
      load_readonly_compose_context || return 1
      rollback_release "$ISSUEBOT_HOME/deployments/previous.manifest"
      ;;
    status)
      load_readonly_compose_context || return 1
      docker compose --env-file "$DEPLOY_ENV" ps
      ;;
    logs)
      load_readonly_compose_context || return 1
      docker compose --env-file "$DEPLOY_ENV" logs --no-color --tail "${command_parts[2]}" "${command_parts[1]}"
      ;;
  esac
}

set +e
dispatch_output="$(dispatch 2>&1)"
dispatch_status=$?
set -e
[[ -z "$dispatch_output" ]] || redact "$dispatch_output"
exit "$dispatch_status"
