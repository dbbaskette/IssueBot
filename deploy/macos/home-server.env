# Non-secret deployment topology for home-services.local. This file is safe to
# commit. Credentials belong only in ISSUEBOT_RUNTIME_ENV.
ISSUEBOT_SERVICE_HOME=/Users/dbbaskette
ISSUEBOT_CHECKOUT=/Users/dbbaskette/Projects/IssueBot
ISSUEBOT_RUNTIME_ENV=/Users/dbbaskette/.config/issuebot/runtime.env
ISSUEBOT_STATE_DIR=/Users/dbbaskette/.issuebot
ISSUEBOT_JAVA=/Users/dbbaskette/.sdkman/candidates/java/current/bin/java
ISSUEBOT_PORT=8090
ISSUEBOT_AGENT_LABEL=com.baskettecase.issuebot
ISSUEBOT_PUBLIC_HOSTNAME=issuebot.baskettecase.com
# Explicitly permit ADKSI's implementation harness to fetch Maven dependencies.
# Other repositories and planning/review stages remain network-restricted.
ISSUEBOT_CODEX_NETWORK_ALLOWED_REPOSITORIES=dbbaskette/adksi
HOME_SERVER_CHECKOUT=/Users/dbbaskette/Projects/home-server
DOCKER_BIN=/usr/local/bin/docker
